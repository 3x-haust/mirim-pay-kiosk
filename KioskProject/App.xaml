<Application x:Class="KioskProject.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/KioskFoundations.xaml" />
                <ResourceDictionary Source="Resources/KioskControls.xaml" />
                <ResourceDictionary Source="Resources/KioskPortrait.xaml" />
                <ResourceDictionary Source="Resources/KioskAssets.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
