<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Figma nodes 229:667, 229:927, 229:763, and 663:78. -->
    <Color x:Key="KioskPrimaryColor">#FF249D57</Color>
    <Color x:Key="KioskPrimaryStrongColor">#FF208D4E</Color>
    <Color x:Key="KioskSuccessColor">#FF0F9444</Color>
    <Color x:Key="KioskWhiteColor">#FFFFFFFF</Color>
    <Color x:Key="KioskBlackColor">#FF000000</Color>
    <Color x:Key="KioskTextColor">#FF3F3F3F</Color>
    <Color x:Key="KioskTextSecondaryColor">#FF808080</Color>
    <Color x:Key="KioskBorderColor">#FFD7D7D7</Color>
    <Color x:Key="KioskControlBorderColor">#FFCECECE</Color>
    <Color x:Key="KioskDisabledColor">#FFD0D0D0</Color>
    <Color x:Key="KioskFocusColor">#FF111111</Color>

    <SolidColorBrush x:Key="KioskPrimaryBrush" Color="{StaticResource KioskPrimaryColor}" />
    <SolidColorBrush x:Key="KioskPrimaryStrongBrush" Color="{StaticResource KioskPrimaryStrongColor}" />
    <SolidColorBrush x:Key="KioskSuccessBrush" Color="{StaticResource KioskSuccessColor}" />
    <SolidColorBrush x:Key="KioskSurfaceBrush" Color="{StaticResource KioskWhiteColor}" />
    <SolidColorBrush x:Key="KioskBlackBrush" Color="{StaticResource KioskBlackColor}" />
    <SolidColorBrush x:Key="KioskTextOnPrimaryBrush" Color="{StaticResource KioskWhiteColor}" />
    <SolidColorBrush x:Key="KioskTextBrush" Color="{StaticResource KioskTextColor}" />
    <SolidColorBrush x:Key="KioskTextSecondaryBrush" Color="{StaticResource KioskTextSecondaryColor}" />
    <SolidColorBrush x:Key="KioskBorderBrush" Color="{StaticResource KioskBorderColor}" />
    <SolidColorBrush x:Key="KioskControlBorderBrush" Color="{StaticResource KioskControlBorderColor}" />
    <SolidColorBrush x:Key="KioskDisabledBrush" Color="{StaticResource KioskDisabledColor}" />
    <SolidColorBrush x:Key="KioskFocusBrush" Color="{StaticResource KioskFocusColor}" />

    <FontFamily x:Key="KioskFontFamily">Pretendard, Noto Sans KR, Malgun Gothic, Apple SD Gothic Neo</FontFamily>
    <FontFamily x:Key="KioskBrandFontFamily">Pretendard, Noto Sans KR, Malgun Gothic, Apple SD Gothic Neo</FontFamily>

    <sys:Double x:Key="KioskTypeBrand">100</sys:Double>
    <sys:Double x:Key="KioskTypeDisplay">55</sys:Double>
    <sys:Double x:Key="KioskTypeTitle">48</sys:Double>
    <sys:Double x:Key="KioskTypeAction">40</sys:Double>
    <sys:Double x:Key="KioskStartActionType">45</sys:Double>
    <sys:Double x:Key="KioskTypeBodyLarge">36</sys:Double>
    <sys:Double x:Key="KioskTypeBody">32</sys:Double>
    <sys:Double x:Key="KioskTypeLabel">30</sys:Double>
    <sys:Double x:Key="KioskLineBody">48</sys:Double>
    <sys:Double x:Key="KioskLineTitle">66</sys:Double>
    <sys:Double x:Key="KioskLineTotal">58</sys:Double>
    <sys:Double x:Key="KioskDisabledOpacity">0.5</sys:Double>
    <sys:Double x:Key="KioskIconStroke">8</sys:Double>

    <sys:Double x:Key="KioskLogicalWidth">1080</sys:Double>
    <sys:Double x:Key="KioskLogicalHeight">1920</sys:Double>
    <sys:Double x:Key="KioskTouchTargetMin">96</sys:Double>
    <sys:Double x:Key="KioskActionHeight">108</sys:Double>
    <sys:Double x:Key="KioskSecondaryActionHeight">118</sys:Double>
    <sys:Double x:Key="KioskHeroActionHeight">131</sys:Double>
    <sys:Double x:Key="KioskHeaderHeight">152</sys:Double>
    <sys:Double x:Key="KioskPaymentCardHeight">409</sys:Double>
    <sys:Double x:Key="KioskPaymentCardWidth">442</sys:Double>
    <sys:Double x:Key="KioskSuccessCardWidth">906</sys:Double>
    <sys:Double x:Key="KioskSuccessCardHeight">1718</sys:Double>

    <Thickness x:Key="KioskBorderNone">0</Thickness>
    <Thickness x:Key="KioskBorderHairlineBottom">0,0,0,1</Thickness>
    <Thickness x:Key="KioskBorderOutline">3</Thickness>
    <Thickness x:Key="KioskSpaceCompact">16</Thickness>
    <Thickness x:Key="KioskSpaceControl">30</Thickness>
    <Thickness x:Key="KioskSpaceCard">32</Thickness>
    <Thickness x:Key="KioskSpacePage">54</Thickness>
    <Thickness x:Key="KioskFocusThickness">4</Thickness>
    <Thickness x:Key="KioskCardBorderThickness">3</Thickness>
    <Thickness x:Key="KioskPaymentCardBorderThickness">4</Thickness>

    <CornerRadius x:Key="KioskActionRadius">33</CornerRadius>
    <CornerRadius x:Key="KioskCardRadius">46</CornerRadius>
    <CornerRadius x:Key="KioskPaymentCardRadius">50</CornerRadius>
    <CornerRadius x:Key="KioskSuccessCardRadius">59</CornerRadius>
    <CornerRadius x:Key="KioskPillRadius">86</CornerRadius>
</ResourceDictionary>
