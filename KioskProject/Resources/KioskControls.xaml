<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="KioskTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource KioskFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource KioskTypeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource KioskTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="LineHeight" Value="{StaticResource KioskLineBody}" />
    </Style>

    <Style x:Key="KioskTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource KioskTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource KioskTypeDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="{StaticResource KioskLineTitle}" />
    </Style>

    <Style x:Key="KioskTotalTextStyle" TargetType="TextBlock" BasedOn="{StaticResource KioskTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource KioskTypeTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource KioskPrimaryStrongBrush}" />
        <Setter Property="LineHeight" Value="{StaticResource KioskLineTotal}" />
    </Style>

    <Style x:Key="KioskFocusVisualStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource KioskFocusBrush}"
                            BorderThickness="{StaticResource KioskFocusThickness}"
                            CornerRadius="{StaticResource KioskActionRadius}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KioskPrimaryButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource KioskTouchTargetMin}" />
        <Setter Property="MinHeight" Value="{StaticResource KioskActionHeight}" />
        <Setter Property="Padding" Value="{StaticResource KioskSpaceControl}" />
        <Setter Property="Background" Value="{StaticResource KioskPrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KioskTextOnPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KioskPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource KioskBorderNone}" />
        <Setter Property="FontFamily" Value="{StaticResource KioskFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource KioskTypeAction}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KioskFocusVisualStyle}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource KioskActionRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource KioskPrimaryStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource KioskSuccessBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource KioskDisabledBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource KioskDisabledBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource KioskTextSecondaryBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KioskSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource KioskPrimaryButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource KioskSecondaryActionHeight}" />
        <Setter Property="Background" Value="{StaticResource KioskDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KioskDisabledBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KioskBlackBrush}" />
    </Style>

    <Style x:Key="KioskOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource KioskPrimaryButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource KioskHeroActionHeight}" />
        <Setter Property="FontSize" Value="{StaticResource KioskStartActionType}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource KioskTextOnPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource KioskBorderOutline}" />
        <Setter Property="Foreground" Value="{StaticResource KioskTextOnPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource KioskPillRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource KioskPrimaryStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource KioskSuccessBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource KioskDisabledOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KioskCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KioskSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KioskBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource KioskCardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource KioskCardRadius}" />
        <Setter Property="Padding" Value="{StaticResource KioskSpaceCard}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="KioskPaymentCardStyle" TargetType="Border" BasedOn="{StaticResource KioskCardStyle}">
        <Setter Property="Width" Value="{StaticResource KioskPaymentCardWidth}" />
        <Setter Property="Height" Value="{StaticResource KioskPaymentCardHeight}" />
        <Setter Property="BorderBrush" Value="{StaticResource KioskControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource KioskPaymentCardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource KioskPaymentCardRadius}" />
    </Style>

    <Style x:Key="KioskSuccessCardStyle" TargetType="Border" BasedOn="{StaticResource KioskCardStyle}">
        <Setter Property="Width" Value="{StaticResource KioskSuccessCardWidth}" />
        <Setter Property="Height" Value="{StaticResource KioskSuccessCardHeight}" />
        <Setter Property="BorderThickness" Value="{StaticResource KioskBorderNone}" />
        <Setter Property="CornerRadius" Value="{StaticResource KioskSuccessCardRadius}" />
    </Style>

    <Style x:Key="KioskHeaderStyle" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource KioskHeaderHeight}" />
        <Setter Property="Background" Value="{StaticResource KioskSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KioskTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource KioskBorderHairlineBottom}" />
    </Style>
</ResourceDictionary>
