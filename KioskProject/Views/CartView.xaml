<UserControl x:Class="KioskProject.Views.CartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Background="{StaticResource KioskSurfaceBrush}">
    <UserControl.Resources>
        <sys:Double x:Key="CartFooterHeight">443</sys:Double>
        <sys:Double x:Key="CartItemMinHeight">176</sys:Double>
        <sys:Double x:Key="CartLogoSize">110</sys:Double>
        <sys:Double x:Key="CartQuantityButtonSize">96</sys:Double>
        <Thickness x:Key="CartTitleSpacing">54,62,54,38</Thickness>
        <Thickness x:Key="CartListSpacing">54,0,54,30</Thickness>
        <Thickness x:Key="CartItemSpacing">0,13</Thickness>

        <Style x:Key="CartIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource KioskPrimaryButtonStyle}">
            <Setter Property="Width" Value="{StaticResource CartQuantityButtonSize}" />
            <Setter Property="Height" Value="{StaticResource CartQuantityButtonSize}" />
            <Setter Property="MinWidth" Value="{StaticResource CartQuantityButtonSize}" />
            <Setter Property="MinHeight" Value="{StaticResource CartQuantityButtonSize}" />
            <Setter Property="Padding" Value="{StaticResource KioskSpaceCompact}" />
        </Style>
    </UserControl.Resources>

    <ContentControl Style="{StaticResource KioskPortraitHostStyle}"
                    Background="{StaticResource KioskSurfaceBrush}">
        <Grid automation:AutomationProperties.AutomationId="CartViewRoot"
              Background="{StaticResource KioskSurfaceBrush}"
              ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource KioskHeaderHeight}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="{StaticResource CartFooterHeight}" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource KioskHeaderStyle}">
                <Image Width="{StaticResource CartLogoSize}"
                       Height="{StaticResource CartLogoSize}"
                       Margin="26,0,0,0"
                       HorizontalAlignment="Left"
                       Source="{StaticResource KioskLogoAssetPath}"
                       Stretch="Uniform" />
            </Border>

            <Grid Grid.Row="1"
                  automation:AutomationProperties.AutomationId="CartBarcodeState"
                  Margin="{StaticResource CartTitleSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="{StaticResource KioskTypeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource KioskBlackBrush}"
                           Style="{StaticResource KioskTextStyle}"
                           Text="상품을 바코드에 찍어주세요"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        automation:AutomationProperties.AutomationId="ClearCartButton"
                        MinWidth="220"
                        Command="{Binding ClearCartCommand}"
                        Content="상품 전체 삭제"
                        Style="{StaticResource KioskPrimaryButtonStyle}" />
            </Grid>

            <ScrollViewer Grid.Row="2"
                          Margin="{StaticResource CartListSpacing}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Cart.CartItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="{StaticResource CartItemMinHeight}"
                                  Margin="{StaticResource CartItemSpacing}">
                                <Border Style="{StaticResource KioskCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock MaxWidth="560"
                                                       HorizontalAlignment="Left"
                                                       Style="{StaticResource KioskTextStyle}"
                                                       Text="{Binding Menu.Name}"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                                <TextBlock Foreground="{StaticResource KioskPrimaryStrongBrush}"
                                                           Style="{StaticResource KioskTextStyle}"
                                                           Text="{Binding Menu.Price, StringFormat={}{0:N0}원}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="20,0,0,0"
                                                           Foreground="{StaticResource KioskTextSecondaryBrush}"
                                                           Style="{StaticResource KioskTextStyle}"
                                                           Text="{Binding Subtotal, StringFormat=소계 {0:N0}원}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <Button automation:AutomationProperties.AutomationId="DecreaseButton"
                                                    Command="{Binding DataContext.Cart.DecreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource CartIconButtonStyle}">
                                                <Path Width="24"
                                                      Height="24"
                                                      Data="{StaticResource KioskMinusGeometry}"
                                                      Stroke="{StaticResource KioskTextOnPrimaryBrush}"
                                                      StrokeThickness="{StaticResource KioskIconStroke}"
                                                      Stretch="Uniform" />
                                            </Button>
                                            <TextBlock MinWidth="72"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Style="{StaticResource KioskTextStyle}"
                                                       Text="{Binding Quantity}"
                                                       TextWrapping="Wrap" />
                                            <Button automation:AutomationProperties.AutomationId="IncreaseButton"
                                                    Command="{Binding DataContext.Cart.IncreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource CartIconButtonStyle}">
                                                <Path Width="24"
                                                      Height="24"
                                                      Data="{StaticResource KioskPlusGeometry}"
                                                      Stroke="{StaticResource KioskTextOnPrimaryBrush}"
                                                      StrokeThickness="{StaticResource KioskIconStroke}"
                                                      Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Button automation:AutomationProperties.AutomationId="RemoveButton"
                                        Width="{StaticResource KioskTouchTargetMin}"
                                        Height="{StaticResource KioskTouchTargetMin}"
                                        Margin="-32,-32,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Command="{Binding DataContext.Cart.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource KioskSecondaryButtonStyle}">
                                    <Path Width="24"
                                          Height="24"
                                          Data="{StaticResource KioskRemoveGeometry}"
                                          Stroke="{StaticResource KioskTextBrush}"
                                          StrokeThickness="{StaticResource KioskIconStroke}"
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="2"
                    automation:AutomationProperties.AutomationId="CartEmptyState"
                    Margin="{StaticResource CartListSpacing}"
                    Background="{StaticResource KioskSurfaceBrush}"
                    Padding="{StaticResource KioskSpacePage}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Cart.CartItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource KioskTextStyle}"
                           Text="장바구니가 비어 있습니다."
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="3"
                    Background="{StaticResource KioskSurfaceBrush}"
                    BorderBrush="{StaticResource KioskTextBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="{StaticResource KioskSpacePage}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{StaticResource KioskTextSecondaryBrush}"
                                   Style="{StaticResource KioskTextStyle}"
                                   Text="주문개수"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1"
                                   Foreground="{StaticResource KioskTextSecondaryBrush}"
                                   Style="{StaticResource KioskTextStyle}"
                                   Text="{Binding Cart.CartItems.Count, StringFormat={}{0}개}"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource KioskTotalTextStyle}"
                                   Text="총 결제금액"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource KioskTotalTextStyle}"
                                   Text="{Binding Cart.TotalPrice, StringFormat={}{0:N0}원}"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <Button Grid.Row="2"
                            automation:AutomationProperties.AutomationId="PaymentButton"
                            MinWidth="320"
                            Margin="0,44,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Command="{Binding ShowPaymentCommand}"
                            Content="결제하기">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource KioskPrimaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cart.CartItems.Count}" Value="0">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </ContentControl>
</UserControl>
