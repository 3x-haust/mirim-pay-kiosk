<UserControl x:Class="KioskProject.Views.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Background="{StaticResource KioskSurfaceBrush}">
    <UserControl.Resources>
        <GridLength x:Key="PaymentFooterHeight">443</GridLength>
        <sys:Double x:Key="PaymentLogoSize">110</sys:Double>
        <sys:Double x:Key="PaymentIconSize">118</sys:Double>
        <sys:Double x:Key="PaymentSuccessIconSize">280</sys:Double>
        <Thickness x:Key="PaymentTitleSpacing">75,82,75,0</Thickness>
        <Thickness x:Key="PaymentChoiceSpacing">18</Thickness>

        <Style x:Key="SuccessAcknowledgeButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="{StaticResource KioskTouchTargetMin}" />
            <Setter Property="MinHeight" Value="{StaticResource KioskTouchTargetMin}" />
            <Setter Property="Padding" Value="{StaticResource KioskSpaceCompact}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{StaticResource KioskBorderOutline}" />
            <Setter Property="Foreground" Value="{StaticResource KioskPrimaryStrongBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource KioskBrandFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource KioskTypeTitle}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KioskFocusVisualStyle}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource KioskActionRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource KioskPrimaryStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource KioskDisabledBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource KioskDisabledOpacity}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaymentChoiceButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="{StaticResource KioskPaymentCardWidth}" />
            <Setter Property="Height" Value="{StaticResource KioskPaymentCardHeight}" />
            <Setter Property="Margin" Value="{StaticResource PaymentChoiceSpacing}" />
            <Setter Property="Background" Value="{StaticResource KioskSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KioskControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource KioskPaymentCardBorderThickness}" />
            <Setter Property="Foreground" Value="{StaticResource KioskBlackBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource KioskFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource KioskTypeTitle}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KioskFocusVisualStyle}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource KioskPaymentCardRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource KioskPrimaryStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource KioskDisabledBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource KioskDisabledOpacity}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ContentControl Style="{StaticResource KioskPortraitHostStyle}"
                    Background="{StaticResource KioskSurfaceBrush}">
        <Grid automation:AutomationProperties.AutomationId="PaymentViewRoot"
              ClipToBounds="True">
            <Grid x:Name="SelectionState"
                  automation:AutomationProperties.AutomationId="PaymentSelectionState"
                  Background="{StaticResource KioskSurfaceBrush}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaymentSuccessful}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource KioskHeaderRowHeight}" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="{StaticResource PaymentFooterHeight}" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource KioskHeaderStyle}">
                    <Image Width="{StaticResource PaymentLogoSize}"
                           Height="{StaticResource PaymentLogoSize}"
                           Margin="26,0,0,0"
                           HorizontalAlignment="Left"
                           Source="{StaticResource KioskLogoImage}"
                           Stretch="Uniform" />
                </Border>

                <Grid Grid.Row="1">
                    <StackPanel Margin="{StaticResource PaymentTitleSpacing}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource KioskTitleTextStyle}"
                                   Text="결제 수단 선택"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,30,0,0"
                                   FontSize="{StaticResource KioskTypeAction}"
                                   Style="{StaticResource KioskTextStyle}"
                                   Text="결제 수단을 선택해주세요"
                                   TextWrapping="Wrap" />
                        <Border automation:AutomationProperties.AutomationId="PaymentErrorState"
                                MaxWidth="850"
                                Margin="0,28,0,0"
                                HorizontalAlignment="Left"
                                Background="{StaticResource KioskSurfaceBrush}"
                                BorderBrush="{StaticResource KioskPrimaryStrongBrush}"
                                BorderThickness="{StaticResource KioskBorderOutline}"
                                CornerRadius="{StaticResource KioskActionRadius}"
                                Padding="{StaticResource KioskSpaceControl}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PaymentError}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PaymentError}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="{StaticResource KioskPrimaryStrongBrush}"
                                       Style="{StaticResource KioskTextStyle}"
                                       Text="{Binding PaymentError}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <Canvas>
                        <Button Canvas.Left="{StaticResource PaymentCardPayX}"
                                Canvas.Top="530"
                                Width="{StaticResource PaymentPayCardWidth}"
                                Height="{StaticResource KioskPaymentCardHeight}"
                                Margin="0"
                                automation:AutomationProperties.AutomationId="PayPaymentButton"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="Pay">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PaymentChoiceButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="Pay">
                                            <Setter Property="BorderBrush" Value="{StaticResource KioskPrimaryStrongBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource KioskPrimaryStrongBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Image Width="{StaticResource PaymentPayIconWidth}"
                                       Height="{StaticResource PaymentPayIconHeight}"
                                       Source="{StaticResource KioskPayIcon}"
                                       Stretch="Uniform" />
                                <TextBlock Margin="0,100,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource KioskTypeTitle}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Style="{StaticResource KioskTextStyle}"
                                           Text="페이"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>

                        <Button Canvas.Left="{StaticResource PaymentCardFaceX}"
                                Canvas.Top="530"
                                Width="{StaticResource PaymentFaceCardWidth}"
                                Height="{StaticResource KioskPaymentCardHeight}"
                                Margin="0"
                                automation:AutomationProperties.AutomationId="FacePaymentButton"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="Face">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PaymentChoiceButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="Face">
                                            <Setter Property="BorderBrush" Value="{StaticResource KioskPrimaryStrongBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource KioskPrimaryStrongBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Image Width="{StaticResource PaymentFaceIconWidth}"
                                       Height="{StaticResource PaymentFaceIconHeight}"
                                       Source="{StaticResource KioskFaceIcon}"
                                       Stretch="Uniform" />
                                <TextBlock Margin="0,100,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource KioskTypeTitle}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Style="{StaticResource KioskTextStyle}"
                                           Text="얼굴인식"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </Canvas>
                </Grid>

                <Border Grid.Row="2"
                        Background="{StaticResource KioskSurfaceBrush}"
                        BorderBrush="{StaticResource KioskTextBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="{StaticResource PaymentFooterInset}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource KioskTextSecondaryBrush}"
                                       Style="{StaticResource KioskTextStyle}"
                                       Text="주문개수"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1"
                                       Foreground="{StaticResource KioskTextSecondaryBrush}"
                                       Style="{StaticResource KioskTextStyle}"
                                       Text="{Binding Cart.TotalQuantity, StringFormat={}{0}개}"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,28,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource KioskTotalTextStyle}"
                                       Text="총 결제금액"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource KioskTotalTextStyle}"
                                       Text="{Binding Cart.TotalPrice, StringFormat={}{0}원}"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,44,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button automation:AutomationProperties.AutomationId="BackButton"
                                    Command="{Binding BackToCartCommand}"
                                    Content="이전"
                                    Width="{StaticResource PaymentFooterButtonWidth}"
                                    Style="{StaticResource KioskSecondaryButtonStyle}" />
                            <Button Grid.Column="2"
                                    automation:AutomationProperties.AutomationId="NextButton"
                                    Command="{Binding CompletePaymentCommand}"
                                    Content="다음"
                                    Width="{StaticResource PaymentFooterButtonWidth}"
                                    Style="{StaticResource KioskPrimaryButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="SuccessState"
                  automation:AutomationProperties.AutomationId="PaymentSuccessState"
                  Background="{StaticResource KioskPrimaryBrush}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaymentSuccessful}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Canvas.Left="{StaticResource KioskSuccessCardX}"
                        Canvas.Top="{StaticResource KioskSuccessCardY}"
                        Width="{StaticResource KioskSuccessCardWidth}"
                        Height="{StaticResource KioskSuccessCardHeight}"
                        Tag="{StaticResource KioskSuccessCardRadius}"
                        Style="{StaticResource KioskSuccessCardStyle}">
                    <Canvas>
                        <Image Canvas.Left="{StaticResource PaymentSuccessIconX}"
                               Canvas.Top="{StaticResource PaymentSuccessIconY}"
                               Width="{StaticResource PaymentSuccessIconWidth}"
                               Height="{StaticResource PaymentSuccessIconHeight}"
                               Source="{StaticResource KioskSuccessIcon}"
                               Stretch="Uniform" />
                        <TextBlock Canvas.Left="{StaticResource PaymentSuccessMessageX}"
                                   Canvas.Top="{StaticResource PaymentSuccessMessageY}"
                                   Width="{StaticResource PaymentSuccessMessageWidth}"
                                   Height="{StaticResource PaymentSuccessMessageHeight}"
                                   FontFamily="{StaticResource KioskFontFamily}"
                                   FontSize="{StaticResource PaymentSuccessMessageType}"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource KioskBlackBrush}"
                                   LineHeight="66"
                                   Text="결제가 성공적으로&#x0a;완료되었습니다!"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Canvas.Left="{StaticResource CompleteButtonX}"
                                Canvas.Top="{StaticResource CompleteButtonY}"
                                Width="{StaticResource CompleteButtonWidth}"
                                automation:AutomationProperties.AutomationId="CompleteButton"
                                Command="{Binding AcknowledgePaymentCommand}"
                                Content="MIRIM PAY"
                                Style="{StaticResource SuccessAcknowledgeButtonStyle}" />
                    </Canvas>
                </Border>
            </Grid>
        </Grid>
    </ContentControl>
</UserControl>
